          "stringUnit" : {
            "state" : "translated",
            "value" : "高光优先"
          }
        }
      }
    },
    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“高光优先”保护明亮边缘。“颜色优先”同时降低颜色。“叠加显示”均匀覆盖边缘。"
          }
