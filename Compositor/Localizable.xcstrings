    "Clear the haze that leaves background showing through thin areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去除使背景从薄透区域透出的雾霭"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升高时去除雾霭，降低时增加雾霭。"
          }
        }
      }
    },
    "Click a pixel that should be neutral.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击一个应为中性的像素。"
          }
        }
      }
    },
    "Click a purple or green fringe to set its hue range.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击紫色或绿色边缘条纹以设定其色相范围。"
          }
        }
      }
    },
    "Click a shortcut, then press its new key combination. Changes apply when you save.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击一个快捷键，然后按下新的按键组合。保存时应用更改。"
          }
        }
      }
