{
  "sourceLanguage": "en",
  "strings": {
    "%@ color": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@颜色"
          }
        }
      }
    },
    "%@ the selection by this many pixels": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将选区%@此像素数"
