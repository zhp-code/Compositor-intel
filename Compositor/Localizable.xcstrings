      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使明暗色调差异更大或更小，主要作用于中间区域。"
