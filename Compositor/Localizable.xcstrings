      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使线条沿屏幕横向摆动，像失同步的 CRT"
